{
  "name": "landonorris-rebuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "1:1 engineering rebuild of landonorris.com for learning purposes",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "serve:mirror": "node scripts/serve.mjs --port 5177",
    "serve:dist": "node scripts/serve.mjs --port 5178 --root dist",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "@rive-app/canvas-lite": "2.26.4",
    "gsap": "3.13.0",
    "lenis": "1.1.20",
    "three": "0.174.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.3.5"
  }
}
