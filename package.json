    "lil-gui": "^0.21.0",
    "stats-gl": "^4.2.3",
    "three": "0.174.0",
    "three-msdf-text-utils": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.174.0",
    "typescript": "^5.6.0",
    "vite": "^6.3.5"
  }
}
